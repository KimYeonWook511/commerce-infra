[Unit]
Description=pistat 서버 모니터
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/commerce-platform/commerce-infra/docker/pi-monitoring
ExecStart=/usr/bin/python3 /home/pi/commerce-platform/commerce-infra/docker/pi-monitoring/monitor.py
Restart=always
RestartSec=5

# 앞단 웹서버만 이 포트에 닿게 한다. TLS 와 비밀번호는 그쪽이 처리한다.
#
# 웹서버가 같은 호스트의 프로세스면 127.0.0.1 로 둔다.
# 웹서버가 컨테이너 안에 있으면 그 컨테이너가 속한 네트워크의 게이트웨이 주소로 둔다.
# 기본 브리지(172.17.0.1)는 다른 네트워크의 컨테이너에서 닿지 않는다.
# 0.0.0.0 으로 열면 같은 공유기에 붙은 기기가 인증 없이 접근하게 된다.
Environment=PISTAT_HOST=172.18.0.1
Environment=PISTAT_PORT=8088
Environment=PISTAT_INTERVAL=5
Environment=PISTAT_HISTORY_MIN=60

# 컨테이너 조회. 소켓 프록시를 거친다.
Environment=PISTAT_DOCKER=tcp://127.0.0.1:2375
# 로그 보기를 끄려면 0 으로 바꾼다.
Environment=PISTAT_LOGS=1

# 컨테이너를 프로젝트별로 묶는다. 규칙은 README 의 "프로젝트별로 나눠 보기" 참고.
Environment=PISTAT_GROUPS=commerce:commerce-|crocobird:crocobird-,@crocobird

# 전압 부족 플래그를 읽으려면 vcgencmd 가 video 그룹 권한을 필요로 한다.
SupplementaryGroups=video

# cgroup 과 컨테이너 프로세스의 네트워크 통계를 읽어야 하므로 ProtectSystem 은
# full 까지만 올린다. strict 로 하면 /sys 접근이 막힌다.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
